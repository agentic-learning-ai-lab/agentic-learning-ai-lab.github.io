<!doctype html>
<html lang="en">
<head>
    <meta property="og:title" content="Tags | Agentic Learning AI Lab" />
    <meta property="og:description" content="Browse research at the Agentic Learning AI Lab by tag." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://agenticlearning.ai/tags/" />
    <meta property="og:image" content="{{cdnUrl '/assets/images/background/bg3.png'}}" />
    {{> head description="Browse research at the Agentic Learning AI Lab by tag."}}
</head>
<body class="tw-flex tw-min-h-[100vh] tw-flex-col tw-bg-[var(--bg)] tw-font-mono">
    {{> header}}

    <section class="tw-flex tw-w-full tw-flex-col tw-p-[5%] tw-mt-[150px] max-lg:tw-p-4">
        <h3 class="text-left tw-text-4xl tw-font-medium max-md:tw-text-2xl">
            Tags
        </h3>
        <div class="section-underline tw-my-4"></div>

        <p class="tw-text-[var(--fg-muted)] tw-mt-2 tw-max-w-3xl">
            {{total}} tags spanning the lab's research directions. Each links
            to a page listing every paper that carries it.
        </p>

        {{#each clusters}}
        <div class="tw-mt-12">
            <h4 class="tw-text-xl tw-font-medium tw-text-[var(--fg-muted)] max-md:tw-text-lg">
                {{label}}
            </h4>
            <div class="section-underline tw-my-3"></div>

            <ul class="tw-mt-4 tw-flex tw-flex-col tw-gap-3">
                {{#each tags}}
                <li>
                    <a href="/tags/{{slug}}/" class="tag-index-row">
                        <span class="tag-monogram-badge tag-monogram-badge--sm">{{monogram}}</span>
                        <span class="tag-index-row__body">
                            <span class="tag-index-row__label">{{label}}</span>
                            <span class="tag-index-row__desc">{{description}}</span>
                        </span>
                    </a>
                </li>
                {{/each}}
            </ul>
        </div>
        {{/each}}
    </section>

    {{> footer}}
</body>
<script src="/index.js"></script>
</html>
