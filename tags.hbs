<!doctype html>
<html lang="en">
<head>
    <meta property="og:title" content="Topics | Agentic Learning AI Lab" />
    <meta property="og:description" content="Browse research at the Agentic Learning AI Lab by tag." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://agenticlearning.ai/tags/" />
    <meta property="og:image" content="{{cdnUrl '/assets/images/background/bg3.png'}}" />
    {{> head title="Topics" description="Browse research at the Agentic Learning AI Lab by topic."}}
</head>
<body class="tw-flex tw-min-h-[100vh] tw-flex-col tw-bg-[var(--bg)] tw-font-mono">
    {{> header}}

    <section class="tw-flex tw-w-full tw-flex-col tw-p-[5%] tw-mt-[150px] max-lg:tw-p-4">
        <h3 class="text-left tw-text-4xl tw-font-medium max-md:tw-text-2xl">
            Topics
        </h3>
        <div class="section-underline tw-my-4"></div>

        <div class="tw-flex-col tw-w-full tw-max-w-[720px] tw-min-w-0">
        {{#each clusters}}
        <div class="tw-mt-12">
            <h4 class="tw-text-xl tw-font-medium tw-text-[var(--fg-muted)] max-md:tw-text-lg">
                {{label}}
            </h4>
            <div class="section-underline tw-my-3"></div>

            <div class="tw-mt-4 tw-flex tw-flex-col tw-gap-y-2">
                {{#each tags}}
                <a href="/tags/{{slug}}/" class="search-result-item person-paper-item">
                    <div class="search-result-content tag-index-item__content">
                        <span class="tag-monogram-badge" aria-hidden="true">{{monogram}}</span>
                        <div class="search-result-text">
                            <div class="search-result-title">{{label}}</div>
                            <div class="search-result-subtitle">{{description}}</div>
                        </div>
                        <i class="bi bi-arrow-right search-result-arrow"></i>
                    </div>
                </a>
                {{/each}}
            </div>
        </div>
        {{/each}}
        </div>
    </section>

    {{> footer}}
</body>
<script src="/index.js"></script>
</html>
