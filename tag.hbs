<!doctype html>
<html lang="en">
<head>
<meta property="og:title" content="{{{label}}} | Agentic Learning AI Lab" />
<meta property="og:description" content="{{{description}}}" />
<meta property="og:type" content="website" />
<meta property="og:url" content="https://agenticlearning.ai/tags/{{{slug}}}/" />
{{> head title=label description=description}}
</head>
<body class="tw-flex tw-min-h-[100vh] tw-flex-col tw-bg-[var(--bg)] tw-font-mono">
    {{> header}}

    <section class="tw-flex tw-flex-row tw-w-full tw-gap-12 tw-px-[5%] tw-pt-[5%] tw-pb-[3%] tw-mt-[150px] max-lg:tw-p-4">
        <div class="tw-flex tw-flex-col tw-w-full tw-max-w-[720px] tw-min-w-0">
            <a href="/tags/" class="tag-back-link"><i class="bi bi-arrow-left"></i> All topics</a>
            <div class="tw-flex tw-items-center tw-gap-4">
                <span class="tag-monogram-badge" aria-hidden="true">{{monogram}}</span>
                <h1 class="text-left tw-text-4xl tw-font-medium max-md:tw-text-2xl">
                    {{label}}
                </h1>
            </div>
            <p class="tw-text-[var(--fg-muted)] tw-mt-6">
                {{{description}}}
            </p>

            {{#if papers}}
            <h3 class="tw-mt-8 text-left tw-text-xl tw-font-medium max-md:tw-text-2xl">
                Papers
            </h3>
            <div id="flexContainer" data-page-size="10" class="tw-mt-4 tw-flex tw-flex-col tw-gap-y-2">
                {{> person_paper papers }}
            </div>

            <div class="pagination-controls tw-mt-12 tw-flex tw-justify-center tw-items-center tw-gap-2">
                <button id="prevButton" class="tw-px-6 tw-py-1 tw-text-[var(--fg)] disabled:tw-opacity-30"
                    onclick="prevPage()">Prev</button>
                <span id="pageNumbers" class="tw-flex tw-gap-2"></span>
                <button id="nextButton" class="tw-px-6 tw-py-1 tw-text-[var(--fg)] disabled:tw-opacity-30"
                    onclick="nextPage()">Next</button>
            </div>
            {{/if}}
        </div>

        <nav class="tag-aside" aria-label="Topics">
            {{#each navClusters}}
            <div class="tag-aside__group">
                <div class="tag-aside__heading">{{label}}</div>
                <ul>
                    {{#each tags}}
                    <li><a href="/tags/{{slug}}/" class="tag-aside__link{{#if isCurrent}} is-current{{/if}}"{{#if isCurrent}} aria-current="page"{{/if}}>{{label}}</a></li>
                    {{/each}}
                </ul>
            </div>
            {{/each}}
        </nav>
    </section>

    {{> footer}}
</body>
<script src="/index.js"></script>
<script src="/person.js"></script>
</html>
