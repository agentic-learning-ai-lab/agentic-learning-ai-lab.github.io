<!doctype html>
<html lang="en">
<head>
<meta property="og:title" content="{{{label}}} | Agentic Learning AI Lab" />
<meta property="og:description" content="{{{description}}}" />
<meta property="og:type" content="website" />
<meta property="og:url" content="https://agenticlearning.ai/tags/{{{slug}}}/" />
{{> head title=label description=description}}
</head>
<body class="tw-flex tw-min-h-[100vh] tw-flex-col tw-bg-[var(--bg)] tw-font-mono">
    {{> header}}

    <section class="tw-flex tw-w-full tw-flex-col tw-p-[5%] tw-pb-0 tw-mt-[150px] max-lg:tw-p-4 max-lg:tw-pb-0">
        <nav class="tag-nav" aria-label="Research topics">
            <a href="/tags/" class="tag-chip">All</a>
            {{#each allTags}}<a href="/tags/{{slug}}/" class="tag-chip{{#if isCurrent}} tag-chip--active{{/if}}"{{#if isCurrent}} aria-current="page"{{/if}}>{{label}}</a>{{/each}}
        </nav>
        <div class="tw-flex tw-items-center tw-gap-4">
            <span class="tag-monogram-badge tag-monogram-badge--sm" aria-hidden="true">{{monogram}}</span>
            <h1 class="text-left tw-text-4xl tw-font-medium max-md:tw-text-2xl">
                {{label}}
            </h1>
        </div>
        <p class="tw-text-[var(--fg-muted)] tw-mt-6 tw-max-w-3xl">
            {{{description}}}
        </p>
    </section>

    <section class="tw-w-full tw-flex-col tw-px-[5%] tw-py-[3%] max-lg:tw-p-4">
        {{#if papers}}
        <div class="tw-flex-col sm:tw-w-[100%] md:tw-w-[80%] lg:tw-w-[60%] xl:tw-w-[50%]">
            <h3 class="tw-mt-10 text-left tw-text-xl tw-font-medium max-md:tw-text-2xl">
                Papers
            </h3>
            <div id="flexContainer" data-page-size="10" class="tw-mt-4 tw-flex tw-flex-col tw-gap-y-2">
                {{> person_paper papers }}
            </div>

            <div class="pagination-controls tw-mt-12 tw-flex tw-justify-center tw-items-center tw-gap-2">
                <button id="prevButton" class="tw-px-6 tw-py-1 tw-text-[var(--fg)] disabled:tw-opacity-30"
                    onclick="prevPage()">Prev</button>
                <span id="pageNumbers" class="tw-flex tw-gap-2"></span>
                <button id="nextButton" class="tw-px-6 tw-py-1 tw-text-[var(--fg)] disabled:tw-opacity-30"
                    onclick="nextPage()">Next</button>
            </div>
        </div>
        {{/if}}
    </section>

    {{> footer}}
</body>
<script src="/index.js"></script>
<script src="/person.js"></script>
</html>
