{{!-- Featured tag tile for the home page grid. Whole tile is the
      click target. --}}
<a href="/tags/{{slug}}/" class="tag-card">
    <span class="tag-monogram-badge" aria-hidden="true">{{monogram}}</span>
    <span class="tag-card__body">
        <span class="tag-card__label">{{label}}</span>
        <span class="tag-card__desc">{{description}}</span>
    </span>
</a>
